# ---------------------------------------------------------------------------
# Platform environment. Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Session key for the local OpenHands agent server. On a managed runtime it is
# already exported as SESSION_API_KEY; on a self-hosted setup read it from
# ~/.openhands/agent-canvas/api-key.txt.
SESSION_API_KEY=

# --- Optional ---------------------------------------------------------------
# SQLite database path (must be on a durable volume).
OHP_DB=/home/openhands/.ohp/platform.db

# Local agent server base URL.
OHP_AGENT_SERVER_URL=http://127.0.0.1:60000

# OpenHands Cloud app server (for cross-sandbox delegation).
OHP_CLOUD_URL=https://app.all-hands.dev

# Model used when a task says "inherit". Leave empty to use the server default.
# Managed runtime working value: openhands/deepseek-v4.1-flash
OHP_MODEL=

# Concurrency and timing.
OHP_MAX_PARALLEL=3
OHP_LEASE_SECONDS=600
OHP_TASK_TIMEOUT=1800
OHP_POLL_INTERVAL=5
OHP_REASONING_EFFORT=high
OHP_LOG_LEVEL=INFO

# --- Cloud delegation (only needed for cross-sandbox work) ------------------
OPENHANDS_CLOUD_API_KEY=
