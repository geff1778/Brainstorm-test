# ══════════════════════════════════════════════════════════════
#  BrainStorm — environment template
#  Copy to .env  (cp .env.example .env)  and fill in real values.
#  NEVER commit .env — it is ignored by .gitignore.
# ══════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────
# development | production
ENV=development
HOST=0.0.0.0
PORT=5000
DEBUG=true
LOG_LEVEL=INFO
# Force a SocketIO async mode: eventlet | threading | gevent.
# Leave empty to auto-detect (eventlet when installed, else threading).
SOCKETIO_ASYNC_MODE=

# ── Security ──────────────────────────────────────────────────
# REQUIRED in production. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Set true when the app is served over HTTPS so cookies get the Secure flag.
SESSION_COOKIE_SECURE=false
# Comma-separated allowed browser origins; use explicit origins in production.
CORS_ORIGINS=*
# Trust X-Forwarded-For for client IPs (enable only behind a trusted proxy).
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10

# ── Administration ────────────────────────────────────────────
# Shared keys for the admin panel / tester (cheat) mode. Change both.
ADMIN_SECRET_KEY=change-me
CHEAT_TESTER_CODE=change-me

# ── GigaChat (Sberbank) ───────────────────────────────────────
# Leave GIGACHAT_CREDENTIALS empty to run on the built-in offline question bank.
GIGACHAT_CLIENT_ID=
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ── Storage ───────────────────────────────────────────────────
# Directory for SQLite databases (created automatically).
DATA_DIR=data

# ── Room lifecycle ────────────────────────────────────────────
MAX_ROOMS=500
ROOM_IDLE_TIMEOUT=90
ROOM_EMPTY_TIMEOUT=30
